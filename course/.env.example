# Traversaal Academy · copy to .env and fill in. .env is gitignored.

# ── Sign-in (Clerk) ───────────────────────────────────────────────────────────
# The same Clerk instance as moment-internal-app. Both keys from the Clerk
# dashboard, API keys page. The secret never reaches the browser.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Every hostname the app answers on, comma separated, once it is deployed
# (a session minted on one host is rejected on another that isn't listed).
# Leave empty locally.
PUBLIC_ORIGIN=

# true = no sign-in at all. For a local demo only. With this unset and no Clerk
# keys, gated pages answer 503 on purpose, so a missing secret is never a
# silent public launch.
ALLOW_PUBLIC=false

PORT=8300

# ── Recordings ────────────────────────────────────────────────────────────────
# Where the session videos live: <MEDIA_DIR>/s1.mp4 ... s5.mp4. Default ./media
# MEDIA_DIR=

# Only for the build scripts (scripts/build_transcripts.py, build_frames.py):
# the Zoom export holding the "Session N" folders, and the slide decks.
# LECTURE_ROOT=C:\Users\Areej\Downloads\Course Recording Testing-20260909T112756Z-1-001\Course Recording Testing
# DECK_ROOT=C:\Users\Areej\Desktop\traversaal\moment-search-internal\demo\hamza\multimodal_doc_rag\data

# ── The bot ───────────────────────────────────────────────────────────────────
# The deployed Hamza MomentSearch app answers every question (search by meaning
# and by what was on screen, then a written answer citing the moments). Use the
# "academy" key from that app's API_KEYS; it is unmetered there
# (API_KEY_LIMITS=academy:0) because this site meters each signed-in user.
# The key never reaches the browser. Leave either empty (or set BOT=demo) to use
# the built-in demo bot, which quotes the transcript.
HAMZA_API_URL=https://claude.traversaal.ai
HAMZA_API_KEY=
# BOT=demo
